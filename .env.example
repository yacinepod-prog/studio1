# Required for Gemini AI Reference Analysis, Script Generation, Scene Breakdown, Prompts, TTS & SEO
GEMINI_API_KEY=

# Optional: CodeCraft API (https://codecraftapi.com/v1) for Text, Image & Audio Generation
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1
CODECRAFT_TEXT_MODEL=gpt-4o
CODECRAFT_IMAGE_MODEL=dall-e-3
CODECRAFT_TTS_MODEL=tts-1
CODECRAFT_TTS_VOICE=alloy

# Optional: Enriches YouTube Reference metadata with exact view counts and full descriptions
YOUTUBE_API_KEY=

# Optional external render backend URL
VITE_RENDER_URL=
